# Names only. No values, ever — this file is committed and the repository is
# public. Copy to `.env.local` (gitignored) if you need to override anything.
# Meanings: hackathon/SPEC.md §7.
#
# No secrets exist in this project: there is no API key, token, account or
# card. Every variable below is a local switch or a path.

# kinematic (default, the fake) | sitl | arena
WHITEOUT_TRANSPORT=

# Episode seed. Absent means 0, never "random".
WHITEOUT_SEED=

# Path to the DEM tile. Absent means the synthetic generator.
WHITEOUT_DEM=

# mcast: or udp: endpoint for sim_vehicle.py. Absent means the sitl transport
# refuses to start, loudly.
WHITEOUT_SITL_ENDPOINT=

# The sponsor's endpoint, once known.
WHITEOUT_ARENA_ENDPOINT=

# Output directory. Defaults to artifacts/.
WHITEOUT_ARTIFACTS=

# Viewer server port. Ephemeral when unset.
PORT=
